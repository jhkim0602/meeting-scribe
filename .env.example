# Hugging Face 토큰: 화자 분리 모델(pyannote community-1)을 내려받을 때 필요해요.
# 1) https://huggingface.co/pyannote/speaker-diarization-community-1 에서 약관 동의
# 2) https://huggingface.co/settings/tokens 에서 Read 토큰 발급 후 아래에 붙여넣기
HF_TOKEN=

# 데이터 저장 위치 (기본: ~/MeetingScribe)
# SCRIBE_DATA_DIR=/Users/me/MeetingScribe

# 모델 바꾸기 (기본값: 실시간 Qwen3-ASR-0.6B, 원본 Qwen3-ASR-1.7B)
# SCRIBE_LIVE_MODEL=Qwen/Qwen3-ASR-1.7B
# SCRIBE_FINAL_MODEL=Qwen/Qwen3-ASR-1.7B

# 엔진: auto | qwen3 | whisper | faster-whisper | mock(시연용)
# SCRIBE_LIVE_ENGINE=auto
# SCRIBE_FINAL_ENGINE=auto

# 화자 분리: auto | speakrs | pyannote | none
# SCRIBE_DIARIZER=auto

# 이보다 짧게 멈춘 것은 쉬는 시간 구분선을 만들지 않음 (초)
# SCRIBE_MIN_BREAK_S=20

# 포트
# SCRIBE_PORT=8765

# 127.0.0.1/localhost 외의 주소로 열어야 할 때만 (쉼표로 구분). 보통은 비워 둡니다.
# SCRIBE_ALLOWED_HOSTS=
# SCRIBE_ALLOWED_ORIGINS=
