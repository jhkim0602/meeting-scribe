{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "회의 노트",
  "mainBinaryName": "meeting-scribe",
  "version": "0.1.1",
  "identifier": "com.meetingscribe.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "회의 노트",
        "url": "index.html",
        "width": 620,
        "height": 760,
        "minWidth": 520,
        "minHeight": 620,
        "visible": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "회의를 받아 적고 정리하는 맥 앱",
    "copyright": "",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "resources/app/": "app/",
      "resources/bin/": "bin/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
